  lastPurchasedAt      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  supplier             Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productVariant       ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([supplierId, productVariantId])
}

model SupplierDocument {
  id           String   @id @default(cuid())
  supplierId   String
  name         String
  documentUrl  String
  documentType String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

enum SupplierLedgerEntryType {
  PURCHASE_INVOICE
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  ADJUSTMENT
  REVERSAL
}

model SupplierLedgerEntry {
