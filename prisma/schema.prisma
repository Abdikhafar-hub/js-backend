  publishUntil DateTime?

  isFeatured   Boolean @default(false)
  isNewArrival Boolean @default(false)
  isBestSeller Boolean @default(false)

  displayOrder   Int     @default(0)
  primaryMediaId String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, slug])
  @@index([organizationId, isPublished])
  @@index([organizationId, isFeatured])
  @@index([organizationId, isNewArrival])
  @@index([organizationId, isBestSeller])
}

model ProductVariantStorefrontProfile {
  id               String @id @default(cuid())
  organizationId   String
  productVariantId String @unique

  isPublishedOnline       Boolean  @default(false)
  isDefaultWebsiteVariant Boolean  @default(false)
  compareAtPrice          Decimal? @db.Decimal(18, 2)
  maximumOnlineQuantity   Int?
  allowBackorder          Boolean  @default(false)
  lowStockThreshold       Int?
  websiteLabel            String?
  displayOrder            Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, isPublishedOnline])
}

model ProductMedia {
  id               String  @id @default(cuid())
  organizationId   String
  productId        String
  productVariantId String?

  type            ProductMediaType
  url             String
  storageKey      String?
  storageProvider String?
  resourceType    String?
  format          String?
  bytes           Int?
  width           Int?
  height          Int?
  altText         String?
  title           String?
  displayOrder    Int              @default(0)
  isPrimary       Boolean          @default(false)
  isPublished     Boolean          @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product               Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant        ProductVariant?              @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  organization          Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sectionMediaOverrides StorefrontSectionPlacement[] @relation("SectionPlacementMediaOverride")

  @@index([organizationId, productId])
  @@index([productVariantId])
  @@index([productId, displayOrder])
}

model StorefrontCollection {
  id             String @id @default(cuid())
  organizationId String

  name             String
  slug             String
  description      String?
  shortDescription String?
  imageUrl         String?
  bannerMediaId    String?
  type             StorefrontCollectionType
  isPublished      Boolean                  @default(false)
  displayOrder     Int                      @default(0)

  ruleConfig  Json?
  publishedAt DateTime?
  createdById String
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        StorefrontCollectionItem[]

  @@unique([organizationId, slug])
  @@index([organizationId, isPublished])
  @@index([organizationId, type])
}

model StorefrontCollectionItem {
  id           String    @id @default(cuid())
  collectionId String
  productId    String
  displayOrder Int       @default(0)
  isPinned     Boolean   @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  collection StorefrontCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product              @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId, displayOrder])
  @@index([productId])
}

model StorefrontSection {
  id             String @id @default(cuid())
  organizationId String

  key          String
  page         String
  title        String?
  subtitle     String?
  description  String?
  imageUrl     String?
  ctaLabel     String?
  ctaHref      String?
  layoutType   StorefrontSectionLayoutType @default(PRODUCT_GRID)
  sourceType   StorefrontSectionSourceType @default(MANUAL)
  routeSlug    String?
  maxItems     Int                         @default(0)
  isActive     Boolean                     @default(true)
  displayOrder Int                         @default(0)
  settings     Json?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  placements   StorefrontSectionPlacement[]
  contentCards StorefrontContentCard[]

  @@unique([organizationId, key])
  @@index([organizationId, page, isActive])
  @@index([organizationId, displayOrder])
}

model StorefrontSectionPlacement {
  id             String @id @default(cuid())
  organizationId String
  sectionId      String
  productId      String

  displayOrder     Int       @default(0)
  isPinned         Boolean   @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  titleOverride    String?
  subtitleOverride String?
  mediaOverrideId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  section       StorefrontSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaOverride ProductMedia?     @relation("SectionPlacementMediaOverride", fields: [mediaOverrideId], references: [id], onDelete: SetNull)

  @@unique([sectionId, productId])
  @@index([organizationId, sectionId, displayOrder])
  @@index([productId])
  @@index([mediaOverrideId])
}

model StorefrontContentCard {
  id             String @id @default(cuid())
  organizationId String
  sectionId      String

  title            String
  subtitle         String?
  description      String?
  eyebrow          String?
  imageUrl         String?
  destinationType  StorefrontDestinationType @default(NONE)
  destinationValue String?
  ctaLabel         String?
  displayOrder     Int                       @default(0)
  isActive         Boolean                   @default(true)
  startsAt         DateTime?
  endsAt           DateTime?
  settings         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  section      StorefrontSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, sectionId, displayOrder])
}

model Cart {
  id                String   @id @default(cuid())
  organizationId    String
  token             String   @unique // Unique cart token hash
  customerAccountId String? // For future account login support
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  items        CartItem[]
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
}

model DeliveryZone {
  id                       String   @id @default(cuid())
  organizationId           String
  name                     String
  description              String?
  fee                      Decimal  @default(0) @db.Decimal(18, 2)
  minAmountForFreeDelivery Decimal? @db.Decimal(18, 2)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  onlineOrders OnlineOrder[]

  @@unique([organizationId, name])
}

model OnlineOrder {
  id                String   @id @default(cuid())
  organizationId    String
  orderNumber       String
  customerId        String
  customerAccountId String? // Nullable for guest or future customer account
  cartId            String?  @unique // Unique converted cart
  publicToken       String   @unique // Unique order public token hash
  status            String   @default("PENDING_PAYMENT")
  paymentStatus     String   @default("UNPAID")
  fulfilmentStatus  String   @default("UNFULFILLED")
  deliveryMethod    String // "DELIVERY" or "PICKUP"
  deliveryFee       Decimal  @default(0) @db.Decimal(18, 2)
  deliveryZoneId    String?
  pickupBranchId    String?
  subtotal          Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal  @default(0) @db.Decimal(18, 2)
  notes             String?
  idempotencyKey    String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer          Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryZone      DeliveryZone?               @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  pickupBranch      Branch?                     @relation("PickupBranch", fields: [pickupBranchId], references: [id], onDelete: SetNull)
  items             OnlineOrderItem[]
  addressSnapshot   OnlineOrderAddressSnapshot?
  paymentAttempts   OnlineOrderPaymentAttempt[]
  payments          Payment[]
  mpesaTransactions MpesaTransaction[]
  pickingTasks      PickingTask[]
  packingTasks      PackingTask[]
  dispatch          OrderDispatch?

  @@unique([organizationId, orderNumber])
  @@index([organizationId, customerId])
  @@index([createdAt])
}

model OnlineOrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productVariantId    String
  skuSnapshot         String
  productNameSnapshot String
  variantNameSnapshot String
  quantity            Int
  pickedQuantity      Int     @default(0)
  packedQuantity      Int     @default(0)
  unitPrice           Decimal @db.Decimal(18, 2)
  lineTotal           Decimal @db.Decimal(18, 2)

  order          OnlineOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
}

model OnlineOrderAddressSnapshot {
  id             String  @id @default(cuid())
  orderId        String  @unique
  firstName      String
  lastName       String
  phone          String
  alternatePhone String?
  email          String
  addressLine1   String
  addressLine2   String?
  city           String
  county         String?
  country        String  @default("Kenya")

  order OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

enum OnlinePaymentMethod {
  MPESA
  CASH_ON_DELIVERY
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

model OnlineOrderPaymentAttempt {
  id                String               @id @default(cuid())
  organizationId    String
  onlineOrderId     String
  paymentId         String?
  method            OnlinePaymentMethod
  status            PaymentAttemptStatus
  amount            Decimal              @db.Decimal(18, 2)
  currency          String
  phoneNumber       String?
  externalReference String?
  checkoutRequestId String?
  merchantRequestId String?
  providerReceipt   String?
  failureCode       String?
  failureMessage    String?
  idempotencyKey    String
  initiatedAt       DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  timedOutAt        DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  onlineOrder  OnlineOrder  @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([onlineOrderId, createdAt])
  @@index([checkoutRequestId])
  @@index([merchantRequestId])
}

enum PickingTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  PARTIALLY_PICKED
  COMPLETED
  BLOCKED
  CANCELLED
}

enum PickingTaskItemStatus {
  PENDING
  PICKED
  SHORT
}

model PickingTask {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  onlineOrderId  String
  assignedToId   String?
  status         PickingTaskStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  onlineOrder  OnlineOrder       @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  assignedTo   User?             @relation("AssignedPicks", fields: [assignedToId], references: [id], onDelete: SetNull)
  items        PickingTaskItem[]
}

model PickingTaskItem {
  id                String  @id @default(cuid())
  pickingTaskId     String
  onlineOrderItemId String
  productVariantId  String
  inventoryBatchId  String?

  requiredQuantity Decimal               @db.Decimal(18, 2)
  pickedQuantity   Decimal?              @db.Decimal(18, 2)
  shortQuantity    Decimal?              @db.Decimal(18, 2)
  status           PickingTaskItemStatus @default(PENDING)
  notes            String?

  pickingTask    PickingTask     @relation(fields: [pickingTaskId], references: [id], onDelete: Cascade)
  productVariant ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: SetNull)

  @@index([pickingTaskId])
}

enum PackingTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CANCELLED
}

model PackingTask {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  onlineOrderId  String
  assignedToId   String?
  status         PackingTaskStatus @default(PENDING)

  packageCount Int?
  totalWeight  Decimal? @db.Decimal(18, 2)
  notes        String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  onlineOrder  OnlineOrder  @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedPacking", fields: [assignedToId], references: [id], onDelete: SetNull)
}

enum DispatchStatus {
  PENDING
  DISPATCHED
  DELIVERED
  FAILED
  CANCELLED
}

model OrderDispatch {
  id             String @id @default(cuid())
  organizationId String
  onlineOrderId  String @unique
  branchId       String

  courierName      String?
  courierService   String?
  trackingNumber   String?
  vehicleReference String?
  driverName       String?
  driverPhone      String?

  dispatchedById     String
  dispatchedAt       DateTime
  expectedDeliveryAt DateTime?
  deliveredAt        DateTime?

  status DispatchStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  onlineOrder  OnlineOrder  @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  dispatchedBy User         @relation("DispatchedOrders", fields: [dispatchedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([trackingNumber])
}

enum CustomerAccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

model CustomerAccount {
  id             String @id @default(cuid())
  organizationId String
  customerId     String @unique

  email                 String?
  normalizedEmail       String?
  phoneNumber           String?
  normalizedPhoneNumber String?

  passwordHash      String
  status            CustomerAccountStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  tokenVersion      Int                   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions     CustomerSession[]
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)

  passwordResetTokens     CustomerPasswordResetToken[]
  emailVerificationTokens CustomerEmailVerificationToken[]
  phoneVerificationTokens CustomerPhoneVerificationToken[]

  @@unique([organizationId, normalizedEmail])
  @@unique([organizationId, normalizedPhoneNumber])
  @@index([organizationId, status])
}

model CustomerSession {
  id                String @id @default(cuid())
  customerAccountId String

  refreshTokenHash String    @unique
  userAgent        String?
  ipAddressHash    String?
  lastUsedAt       DateTime?
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?

  createdAt       DateTime        @default(now())
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, expiresAt])
}

model CustomerPasswordResetToken {
  id                String    @id @default(cuid())
  organizationId    String
  customerAccountId String
  tokenHash         String    @unique
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
}

model CustomerEmailVerificationToken {
  id                String    @id @default(cuid())
  organizationId    String
  customerAccountId String
  tokenHash         String    @unique
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
}

model CustomerPhoneVerificationToken {
  id                String    @id @default(cuid())
  organizationId    String
  customerAccountId String
  tokenHash         String    @unique
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
}
