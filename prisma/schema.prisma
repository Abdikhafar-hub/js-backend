  attributeValues       ProductAttributeValue[]
  branchProducts        BranchProduct[]
  submissions           ProductSubmission[]
  priceProposals        ProductPriceProposal[]
  storefrontProfile     ProductStorefrontProfile?
  media                 ProductMedia[]
  collectionItems       StorefrontCollectionItem[]
  sectionPlacements     StorefrontSectionPlacement[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@index([organizationId, approvalStatus])
  @@index([organizationId, normalizedName])
}

model ProductAttributeDefinition {
  id              String   @id @default(cuid())
  organizationId  String
  categoryId      String
