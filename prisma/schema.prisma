model Organization {
  id                              String                            @id @default(cuid())
  legalName                       String
  tradingName                     String
  registrationNumber              String?
  taxNumber                       String?
  email                           String?
  phone                           String?
  address                         String?
  city                            String?
  country                         String                            @default("Kenya")
  currencyCode                    String                            @default("KES")
  timezone                        String                            @default("Africa/Nairobi")
  logoUrl                         String?
  status                          OrganizationStatus                @default(ACTIVE)
  settings                        Json?
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  branches                        Branch[]
  users                           User[]
  refreshTokens                   RefreshToken[]
  securityEvents                  SecurityEvent[]
  loginAttempts                   LoginAttempt[]
  brands                          Brand[]
  categories                      ProductCategory[]
  products                        Product[]
  productAttributeDefinitions     ProductAttributeDefinition[]
  productVariants                 ProductVariant[]
  priceLists                      PriceList[]
  inventoryBalances               InventoryBalance[]
  inventoryBatches                InventoryBatch[]
  inventoryMovements              InventoryMovement[]
  customers                       Customer[]
  shifts                          Shift[]
  sales                           Sale[]
  payments                        Payment[]
  auditLogs                       AuditLog[]
  settingsTyped                   OrganizationSetting[]
  suppliers                       Supplier[]
  purchaseRequisitions            PurchaseRequisition[]
  purchaseOrders                  PurchaseOrder[]
  importShipments                 ImportShipment[]
  goodsReceipts                   GoodsReceipt[]
  inventoryReservations           InventoryReservation[]
  stockTransfers                  StockTransfer[]
  stockCounts                     StockCount[]
  stockIssueReports               StockIssueReport[]
  stockAdjustments                StockAdjustment[]
  wholesaleQuotations             WholesaleQuotation[]
  invoices                        Invoice[]
  creditNotes                     CreditNote[]
  debitNotes                      DebitNote[]
  documentSequences               DocumentSequence[]
  mpesaConfigurations             MpesaConfiguration[]
  mpesaTransactions               MpesaTransaction[]
  mpesaReconciliationRecords      MpesaReconciliationRecord[]
  attendance                      Attendance[]
  dailyBranchReconciliations      DailyBranchReconciliation[]
  expenseCategories               ExpenseCategory[]
  expenses                        Expense[]
  salesTargets                    SalesTarget[]
  notifications                   Notification[]
  returnRequests                  ReturnRequest[]
  refunds                         Refund[]
  exchanges                       Exchange[]
  discountRequests                DiscountRequest[]
  customerLedgerEntries           CustomerLedgerEntry[]
  storefrontProfiles              ProductStorefrontProfile[]
  variantStorefrontProfiles       ProductVariantStorefrontProfile[]
  productMedia                    ProductMedia[]
  storefrontCollections           StorefrontCollection[]
  storefrontSections              StorefrontSection[]
  storefrontSectionPlacements     StorefrontSectionPlacement[]
  storefrontContentCards          StorefrontContentCard[]
  carts                           Cart[]
  onlineOrders                    OnlineOrder[]
  deliveryZones                   DeliveryZone[]
  onlineOrderPaymentAttempts      OnlineOrderPaymentAttempt[]
  pickingTasks                    PickingTask[]
  packingTasks                    PackingTask[]
  orderDispatches                 OrderDispatch[]
  customerAccounts                CustomerAccount[]
  customerPasswordResetTokens     CustomerPasswordResetToken[]
  customerEmailVerificationTokens CustomerEmailVerificationToken[]
  customerPhoneVerificationTokens CustomerPhoneVerificationToken[]
  branchProducts                  BranchProduct[]
  productSubmissions              ProductSubmission[]
  productPriceProposals           ProductPriceProposal[]
}

model OrganizationSetting {
  id                                 String       @id @default(cuid())
  organizationId                     String
  defaultCurrency                    String       @default("KES")
  timezone                           String       @default("Africa/Nairobi")
  taxEnabled                         Boolean      @default(false)
  defaultTaxRate                     Decimal      @default(0) @db.Decimal(18, 2)
  negativeStockAllowed               Boolean      @default(false)
  saleRequiresOpenShift              Boolean      @default(true)
  maximumAttendantDiscount           Decimal      @default(0) @db.Decimal(18, 2)
  maximumBranchManagerDiscount       Decimal      @default(0) @db.Decimal(18, 2)
  maximumBranchManagerRefund         Decimal      @default(0) @db.Decimal(18, 2)
  maximumGeneralManagerRefund        Decimal      @default(0) @db.Decimal(18, 2)
  maximumBranchManagerExpense        Decimal      @default(0) @db.Decimal(18, 2)
  loyaltyEnabled                     Boolean      @default(false)
  wholesaleMinimumQuantity           Decimal      @default(1) @db.Decimal(18, 2)
  inventoryCostingMethod             String       @default("FIFO")
  createdAt                          DateTime     @default(now())
  updatedAt                          DateTime     @updatedAt
  organization                       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cashOnDeliveryEnabled              Boolean      @default(true)
  cashOnDeliveryMaximumOrderAmount   Decimal      @default(100000) @db.Decimal(18, 2)
  cashOnDeliveryAllowedZoneIds       String[]     @default([])
  cashOnDeliveryRequiresConfirmation Boolean      @default(false)

  @@unique([organizationId])
}

model Branch {
  id                         String                      @id @default(cuid())
  organizationId             String
  code                       String
  name                       String
  branchType                 BranchType
  phone                      String?
  email                      String?
  address                    String?
  city                       String?
  county                     String?
  latitude                   Decimal?                    @db.Decimal(10, 7)
  longitude                  Decimal?                    @db.Decimal(10, 7)
  isHeadOffice               Boolean                     @default(false)
  isWarehouse                Boolean                     @default(false)
  status                     BranchStatus                @default(ACTIVE)
  allowsNegativeStock        Boolean                     @default(false)
  defaultPriceListId         String?
  managerUserId              String?                     @unique
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  defaultPriceList           PriceList?                  @relation("BranchDefaultPriceList", fields: [defaultPriceListId], references: [id], onDelete: SetNull)
  manager                    User?                       @relation("BranchManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  userAssignments            UserBranchAssignment[]
  priceLists                 PriceList[]                 @relation("BranchPriceLists")
  inventoryBalances          InventoryBalance[]
  inventoryBatches           InventoryBatch[]
  inventoryMovements         InventoryMovement[]
  customers                  Customer[]
  shifts                     Shift[]
  sales                      Sale[]
  payments                   Payment[]
  auditLogs                  AuditLog[]
  requestingRequisitions     PurchaseRequisition[]       @relation("RequestingBranch")
  destinationPurchaseOrders  PurchaseOrder[]             @relation("DestinationBranch")
  goodsReceipts              GoodsReceipt[]
  inventoryReservations      InventoryReservation[]
  sourceTransfers            StockTransfer[]             @relation("SourceBranch")
  destinationTransfers       StockTransfer[]             @relation("DestinationBranch")
  stockCounts                StockCount[]
  stockIssueReports          StockIssueReport[]
  stockAdjustments           StockAdjustment[]
  wholesaleQuotations        WholesaleQuotation[]
  invoices                   Invoice[]
  documentSequences          DocumentSequence[]
  mpesaTransactions          MpesaTransaction[]
  attendance                 Attendance[]
  dailyBranchReconciliations DailyBranchReconciliation[]
  expenses                   Expense[]
  salesTargets               SalesTarget[]
  notifications              Notification[]
  returnRequests             ReturnRequest[]
  refunds                    Refund[]
  exchanges                  Exchange[]
  discountRequests           DiscountRequest[]
  customerLedgerEntries      CustomerLedgerEntry[]
  pickupOnlineOrders         OnlineOrder[]               @relation("PickupBranch")
  pickingTasks               PickingTask[]
  packingTasks               PackingTask[]
  orderDispatches            OrderDispatch[]
  branchProducts             BranchProduct[]
  productSubmissions         ProductSubmission[]         @relation("OriginatingBranchSubmissions")
  productPriceProposals      ProductPriceProposal[]
  products                   Product[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model User {
  id                       String                   @id @default(cuid())
  organizationId           String
  firstName                String
  lastName                 String
  email                    String                   @unique
  phone                    String?
  passwordHash             String
  role                     UserRole
  status                   UserStatus               @default(INVITED)
  lastLoginAt              DateTime?
  lastLoginIp              String?
  failedLoginAttempts      Int                      @default(0)
  lockedUntil              DateTime?
  passwordChangedAt        DateTime?
  mustChangePassword       Boolean                  @default(true)
  twoFactorEnabled         Boolean                  @default(false)
  twoFactorSecretEncrypted String?
  tokenVersion             Int                      @default(0)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  organization             Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  managedBranch            Branch?                  @relation("BranchManager")
  branchAssignments        UserBranchAssignment[]
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  loginAttempts            LoginAttempt[]
  securityEvents           SecurityEvent[]
  shifts                   Shift[]
  sales                    Sale[]                   @relation("SaleAttendant")
  createdInvoices          Invoice[]                @relation("InvoiceCreatedBy")
  auditLogs                AuditLog[]
  createdSuppliers         Supplier[]               @relation("CreatedSuppliers")
  updatedSuppliers         Supplier[]               @relation("UpdatedSuppliers")
  requestedRequisitions    PurchaseRequisition[]    @relation("RequestedRequisitions")
  createdCategories        ProductCategory[]        @relation("CreatedCategories")
  updatedCategories        ProductCategory[]        @relation("UpdatedCategories")
  approvedRequisitions     PurchaseRequisition[]    @relation("ApprovedRequisitions")
  rejectedRequisitions     PurchaseRequisition[]    @relation("RejectedRequisitions")
  createdPurchaseOrders    PurchaseOrder[]          @relation("CreatedPurchaseOrders")
  submittedPurchaseOrders  PurchaseOrder[]          @relation("SubmittedPurchaseOrders")
  approvedPurchaseOrders   PurchaseOrder[]          @relation("ApprovedPurchaseOrders")
  purchaseOrderApprovals   PurchaseOrderApproval[]
  requestedTransfers       StockTransfer[]          @relation("RequestedTransfers")
  approvedTransfers        StockTransfer[]          @relation("ApprovedTransfers")
  pickedTransfers          StockTransfer[]          @relation("PickedTransfers")
  dispatchedTransfers      StockTransfer[]          @relation("DispatchedTransfers")
  receivedTransfers        StockTransfer[]          @relation("ReceivedTransfers")
  attendance               Attendance[]
  createdExpenses          Expense[]                @relation("CreatedExpenses")
  approvedExpenses         Expense[]                @relation("ApprovedExpenses")
  expenseApprovals         ExpenseApproval[]
  salesTargets             SalesTarget[]
  notifications            Notification[]
  notificationReads        NotificationRead[]
  stockCountAssignments    StockCountAssignment[]
  countedItems             StockCountItem[]         @relation("CountedItems")
  recountedItems           StockCountItem[]         @relation("RecountedItems")
  assignedPicks            PickingTask[]            @relation("AssignedPicks")
  assignedPacking          PackingTask[]            @relation("AssignedPacking")
  dispatchedOrders         OrderDispatch[]          @relation("DispatchedOrders")
  createdProducts          Product[]                @relation("ProductCreatedBy")
  approvedProducts         Product[]                @relation("ProductApprovedBy")
  requestedBranchProducts  BranchProduct[]          @relation("BranchProductRequestedBy")
  approvedBranchProducts   BranchProduct[]          @relation("BranchProductApprovedBy")
  submittedProductRequests ProductSubmission[]      @relation("ProductSubmissionSubmittedBy")
  reviewedProductRequests  ProductSubmission[]      @relation("ProductSubmissionReviewedBy")
  proposedProductPrices    ProductPriceProposal[]   @relation("ProductPriceProposedBy")
  approvedProductPrices    ProductPriceProposal[]   @relation("ProductPriceApprovedBy")

  @@index([organizationId, role, status])
}

model UserBranchAssignment {
  id          String    @id @default(cuid())
  userId      String
  branchId    String
  isPrimary   Boolean   @default(false)
  activeFrom  DateTime  @default(now())
  activeUntil DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
}

model RefreshToken {
  id                String         @id @default(cuid())
  organizationId    String
  userId            String
  tokenHash         String
  familyId          String
  deviceId          String?
  deviceName        String?
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime       @default(now())
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken   RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  previousTokens    RefreshToken[] @relation("RefreshTokenReplacement")

  @@unique([organizationId, tokenHash])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
}

model LoginAttempt {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  email          String
  ipAddress      String?
  userAgent      String?
  success        Boolean
  failureReason  String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

model SecurityEvent {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  type           SecurityEventType
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, createdAt])
}

model Brand {
  id              String                @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  logoUrl         String?
  countryOfOrigin String?
  status          ProductCategoryStatus @default(ACTIVE)
  normalizedName  String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  products        Product[]

  @@unique([organizationId, name])
  @@index([organizationId, normalizedName])
}

model ProductCategory {
  id                   String                       @id @default(cuid())
  organizationId       String
  parentId             String?
  name                 String
  slug                 String
  description          String?
  status               ProductCategoryStatus        @default(ACTIVE)
  sortOrder            Int                          @default(0)
  deletedAt            DateTime?
  createdById          String?
  updatedById          String?
  normalizedName       String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent               ProductCategory?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             ProductCategory[]            @relation("CategoryTree")
  products             Product[]
  createdBy            User?                        @relation("CreatedCategories", fields: [createdById], references: [id], onDelete: SetNull)
