}

model PurchaseRequisition {
  id                       String                    @id @default(cuid())
  organizationId           String
  requestingBranchId       String
  requisitionNumber        String
  requestedById            String
  priority                 RequisitionPriority       @default(MEDIUM)
  reason                   String?
