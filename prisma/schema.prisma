  submittedAt              DateTime?
  approvedById             String?
  approvedAt               DateTime?
  rejectedById             String?
  rejectedAt               DateTime?
  rejectionReason          String?
  convertedPurchaseOrderId String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requestingBranch         Branch                    @relation("RequestingBranch", fields: [requestingBranchId], references: [id], onDelete: Restrict)
  requestedBy              User                      @relation("RequestedRequisitions", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy               User?                     @relation("ApprovedRequisitions", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy               User?                     @relation("RejectedRequisitions", fields: [rejectedById], references: [id], onDelete: Restrict)
  convertedPurchaseOrder   PurchaseOrder?            @relation("RequisitionPO", fields: [convertedPurchaseOrderId], references: [id], onDelete: SetNull)
  items                    PurchaseRequisitionItem[]
  purchaseOrders           PurchaseOrder[]           @relation("SourceRequisition")

  @@unique([organizationId, requisitionNumber])
}

model PurchaseRequisitionItem {
  id                       String              @id @default(cuid())
  requisitionId            String
