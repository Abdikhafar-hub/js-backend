  sourceRequisitionId  String?
  currencyCode         String                  @default("KES")
  exchangeRate         Decimal                 @default(1.0) @db.Decimal(18, 6)
  subtotal             Decimal                 @db.Decimal(18, 2)
  discountAmount       Decimal                 @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal                 @default(0) @db.Decimal(18, 2)
  shippingAmount       Decimal                 @default(0) @db.Decimal(18, 2)
  insuranceAmount      Decimal                 @default(0) @db.Decimal(18, 2)
  customsAmount        Decimal                 @default(0) @db.Decimal(18, 2)
  clearingAmount       Decimal                 @default(0) @db.Decimal(18, 2)
  transportAmount      Decimal                 @default(0) @db.Decimal(18, 2)
  otherLandedCosts     Decimal                 @default(0) @db.Decimal(18, 2)
  totalAmount          Decimal                 @db.Decimal(18, 2)
  paymentTermsDays     Int                     @default(0)
  expectedDeliveryDate DateTime?
  status               PurchaseOrderStatus     @default(DRAFT)
  createdById          String
  submittedById        String?
  submittedAt          DateTime?
  approvedById         String?
  approvedAt           DateTime?
  sentAt               DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier             Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  destinationBranch    Branch                  @relation("DestinationBranch", fields: [destinationBranchId], references: [id], onDelete: Restrict)
  sourceRequisition    PurchaseRequisition?    @relation("SourceRequisition", fields: [sourceRequisitionId], references: [id], onDelete: SetNull)
  createdBy            User                    @relation("CreatedPurchaseOrders", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy          User?                   @relation("SubmittedPurchaseOrders", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy           User?                   @relation("ApprovedPurchaseOrders", fields: [approvedById], references: [id], onDelete: Restrict)
  items                PurchaseOrderItem[]
  approvals            PurchaseOrderApproval[]
  goodsReceipts        GoodsReceipt[]
  shipments            ImportShipment[]
  requisitionLinked    PurchaseRequisition[]   @relation("RequisitionPO")

  @@unique([organizationId, purchaseOrderNumber])
}

